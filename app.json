{
  "expo": {
    "name": "lockdin1.0.0",
    "slug": "lockdin1.0.0",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lockdin100",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "useCleartextTraffic": true,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.lockdin1.x0.x0"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "DT Getai Grotesk Display Black",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/DTGetaiGroteskDisplay-Black.ttf",
                    "weight": 900
                  }
                ]
              },
              {
                "fontFamily": "Geist Medium",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Geist-Medium.ttf",
                    "weight": 500
                  }
                ]
              },
              {
                "fontFamily": "Geist",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Geist-Regular.ttf",
                    "weight": 400
                  }
                ]
              },
              {
                "fontFamily": "Chillax Medium",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Chillax-Medium.otf",
                    "weight": 500
                  }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "./assets/fonts/DTGetaiGroteskDisplay-Black.ttf",
              "./assets/fonts/Geist-Medium.ttf",
              "./assets/fonts/Geist-Regular.ttf",
              "./assets/fonts/Chillax-Medium.otf"
            ]
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
